# =============================================================================
# TraceLog - Local Event Traceability Configuration
# =============================================================================
# Copy this file to .env and adjust values for your local environment.
# This is the SINGLE source of truth for all configuration values.
# =============================================================================

# Application Settings
APP_NAME=tracelog
APP_ENV=local

# HTTP Server
# Also the port docker compose publishes the API on (127.0.0.1 only).
HTTP_PORT=8080
# Maximum size of a POST /events request body, in bytes (default 1 MiB).
# Larger bodies are rejected with 413.
HTTP_MAX_BODY_BYTES=1048576

# PostgreSQL Database
# DB_HOST/DB_PORT are used by the CLI running on your machine. docker compose
# publishes PostgreSQL on 127.0.0.1:${DB_PORT}; if that port is taken (another
# Postgres), change DB_PORT here. Containers ignore these two and use postgres:5432.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tracelog
DB_USER=postgres
# WARNING: default password for local use only. Change it before exposing anything.
DB_PASSWORD=postgres
DB_SSLMODE=disable
