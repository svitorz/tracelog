# =============================================================================
# TraceLog - Local Event Traceability Configuration
# =============================================================================
# Copy this file to .env and adjust values for your local environment.
# This is the SINGLE source of truth for all configuration values.
# =============================================================================

# Application Settings
APP_NAME=tracelog
APP_ENV=local

# HTTP Server
HTTP_PORT=8080
# Maximum size of a POST /events request body, in bytes (default 1 MiB).
# Larger bodies are rejected with 413.
HTTP_MAX_BODY_BYTES=1048576

# PostgreSQL Database
# When running via Docker Compose, DB_HOST should be 'localhost'
# When connecting from inside a container, use 'postgres' (service name)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tracelog
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
